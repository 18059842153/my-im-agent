# 复制为 .env 后填写。LLM Key 留空时走 EchoIntentEngine（不联网，直接回显），方便本地调试。

# --- LLM（OpenAI 兼容接口） ---
IM_AGENT_LLM_BASE_URL=https://api.openai.com/v1
IM_AGENT_LLM_API_KEY=
IM_AGENT_LLM_MODEL=gpt-4o-mini
# 推理模型（先输出 reasoning_content）务必给足 max_tokens
IM_AGENT_MAX_TOKENS=4000
IM_AGENT_SYSTEM_PROMPT=你是一个接入企业微信的 AI 助手，回答请简洁、直接、可执行。
IM_AGENT_MAX_TURNS=20
IM_AGENT_DATA_DIR=data

# --- 企业微信自建应用（--adapter wecom 时必填） ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_HOST=0.0.0.0
WECOM_CALLBACK_PORT=8666
WECOM_CALLBACK_PATH=/wecom/callback

# --- 企业微信智能机器人（--adapter wecom-bot 时必填）---
# 后台：工作台 → 智能机器人 → 配置 → 开启「API 模式」→ 选「长连接」
# 注意：这里的 Secret 是长连接专用，与上面的 Token / EncodingAESKey 不是同一套
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# --- 每日新闻推送 ---
IM_AGENT_NEWS_ENABLED=1
IM_AGENT_NEWS_AT=09:30
IM_AGENT_NEWS_TARGET_USER=ChenKeCheng
IM_AGENT_NEWS_CATCHUP_MINUTES=90
IM_AGENT_NEWS_TOP_N=15
IM_AGENT_NEWS_MAX_BYTES=3800
IM_AGENT_NEWS_FETCH_TIMEOUT=15
IM_AGENT_NEWS_TOTAL_TIMEOUT=180
IM_AGENT_NEWS_SUMMARY_CHUNK=5

# --- 新闻正文补抓（抓不到就用 RSS 描述兜底） ---
IM_AGENT_NEWS_ARTICLE_FETCH=1
IM_AGENT_NEWS_ARTICLE_TIMEOUT=12
IM_AGENT_NEWS_ARTICLE_MAX_BYTES=400000
IM_AGENT_NEWS_ARTICLE_CONCURRENCY=5
IM_AGENT_NEWS_ARTICLE_CHARS=1200

# --- 当天归档与下载（md + html） ---
# 公网前缀填到域名或 IP:端口，链接形如 {前缀}/news/2026-11-18.html
IM_AGENT_NEWS_ARCHIVE_DIR=
IM_AGENT_NEWS_PUBLIC_BASE_URL=
IM_AGENT_NEWS_SERVE_HOST=0.0.0.0
IM_AGENT_NEWS_SERVE_PORT=8677
# 可选访问口令；设置后下载链接需带 ?token=xxx
IM_AGENT_NEWS_TOKEN=

# --- 掘金 RSS ---
# 掘金没有官方 RSS，默认走公共 RSSHub；自建实例填内网地址，如 http://127.0.0.1:1200
IM_AGENT_NEWS_RSSHUB_BASE=https://rsshub.app
