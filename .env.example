# 复制为 .env 后填写。LLM Key 留空时走 EchoIntentEngine（不联网，直接回显），方便本地调试。

# --- LLM（OpenAI 兼容接口） ---
IM_AGENT_LLM_BASE_URL=https://api.openai.com/v1
IM_AGENT_LLM_API_KEY=
IM_AGENT_LLM_MODEL=gpt-4o-mini
# 推理模型（先输出 reasoning_content）务必给足 max_tokens
IM_AGENT_MAX_TOKENS=4000
IM_AGENT_SYSTEM_PROMPT=你是一个接入企业微信的 AI 助手，回答请简洁、直接、可执行。
IM_AGENT_MAX_TURNS=20
IM_AGENT_DATA_DIR=data

# --- 企业微信自建应用（--adapter wecom 时必填） ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_HOST=0.0.0.0
WECOM_CALLBACK_PORT=8666
WECOM_CALLBACK_PATH=/wecom/callback

# --- 企业微信智能机器人（--adapter wecom-bot 时必填）---
# 后台：工作台 → 智能机器人 → 配置 → 开启「API 模式」→ 选「长连接」
# 注意：这里的 Secret 是长连接专用，与上面的 Token / EncodingAESKey 不是同一套
WECOM_BOT_ID=
WECOM_BOT_SECRET=
